# ===== Servidor =====
PORT=4000
NODE_ENV=production

# ===== Base de datos Postgres (EasyPanel) =====
# Pegar la URL completa que da EasyPanel al crear el servicio Postgres.
DATABASE_URL=postgres://user:password@host:5432/daguasversel
# Si tu Postgres no tiene SSL (típico en red interna de EasyPanel), deja en false.
DATABASE_SSL=false

# ===== JWT =====
# Genera dos cadenas random largas y distintas. Ej: openssl rand -hex 64
JWT_SECRET=cambia_esto_por_una_cadena_random_larga
JWT_REFRESH_SECRET=cambia_esto_por_otra_cadena_random_larga
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Resend =====
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@tu-dominio-verificado.com
RESEND_FROM_NAME=D'Aguas

# ===== URLs =====
# URL pública del frontend (Vercel). Va en los enlaces de los emails.
APP_URL=https://daguasversel.vercel.app
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=https://daguasversel.vercel.app,http://localhost:8080

# ===== Reset de contraseña =====
PASSWORD_RESET_TTL_MIN=60

# ===== Rate limit =====
# Solo true en pruebas locales.
RATE_LIMIT_DISABLED=false

# ===== Bootstrap de admin inicial =====
# Si la tabla usuarios está vacía al arrancar, crea este admin (sin contraseña, recibe email de invitación).
# Dejar vacío para deshabilitar el bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NOMBRE=
